// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Models
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String?
  emailVerified Boolean   @default(false)
  emailToken    String?
  tokenExpires  DateTime?
  plan          Plan      @default(FREE)
  usageCount    Int       @default(0)
  lastUsedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  payments      Payment[]
  files         File[]
  reconciliationRuns ReconciliationRun[]
  mappingTemplates   ReconciliationMappingTemplate[]

  @@map("users")
}

model ReconciliationRun {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  status      String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  taxPeriod   String?
  totalMatched Int     @default(0)
  totalMismatch Int    @default(0)
  totalOnlyPr   Int    @default(0)
  totalOnly2b   Int    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sources     ReconciliationSource[]
  invoices    ReconciliationInvoice[]
  matches     ReconciliationMatch[]

  @@map("reconciliation_runs")
}

model ReconciliationSource {
  id             String   @id @default(cuid())
  runId          String
  run            ReconciliationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  sourceType     String   // "PR" (Purchase Register) or "GSTR2B"
  filename       String
  originalName   String
  totalRows      Int      @default(0)
  columnMapping  String?  // JSON string of mapped columns
  createdAt      DateTime @default(now())

  @@map("reconciliation_sources")
}

model ReconciliationInvoice {
  id             String   @id @default(cuid())
  runId          String
  run            ReconciliationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  sourceType     String   // "PR" or "GSTR2B"
  gstin          String
  supplierName   String?
  invoiceNo      String
  normInvoiceNo  String
  invoiceDate    String?
  docType        String   @default("INV") // INV, CRN, DBN
  taxableValue   Float    @default(0)
  invoiceValue   Float    @default(0)
  igst           Float    @default(0)
  cgst           Float    @default(0)
  sgst           Float    @default(0)
  cess           Float    @default(0)
  gstRate        Float    @default(0)
  rowNumber      Int
  rawRowData     String?  // JSON string
  createdAt      DateTime @default(now())

  @@map("reconciliation_invoices")
}

model ReconciliationMatch {
  id             String   @id @default(cuid())
  runId          String
  run            ReconciliationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  matchStatus    String   // EXACT, NORMALIZED, AMOUNT_MISMATCH, TAX_MISMATCH, PROBABLE, ONLY_PR, ONLY_2B, DUPLICATE
  prInvoiceId    String?
  gstr2bInvoiceId String?
  confidence     Float    @default(1.0)
  discrepancies  String?  // JSON details of mismatch
  reviewStatus   String   @default("PENDING") // PENDING, ACCEPTED, REJECTED, RESOLVED
  remarks        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("reconciliation_matches")
}

model ReconciliationMappingTemplate {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  sourceType  String   // "PR" or "GSTR2B"
  mappingJson String   // JSON string of column mappings
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("reconciliation_mapping_templates")
}

model Payment {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Float
  currency  String    @default("INR")
  plan      Plan
  status    PaymentStatus @default(PENDING)
  qrCode    String?
  paymentId String?   // From payment gateway
  verifiedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("payments")
}

model File {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  filename    String
  originalName String
  size        Int
  mimeType    String
  ledgerType  LedgerType
  gstRate     Float
  delayDays   Int
  resultPath  String?
  status      FileStatus @default(PROCESSING)
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("files")
}

// Enums
enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  EXPIRED
}

enum LedgerType {
  SINGLE
  MULTI
}

enum FileStatus {
  PROCESSING
  COMPLETED
  FAILED
}
